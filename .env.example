# ==========================================
# Royal Haven Environment Configuration
# ==========================================

# --- Resend Transactional Email (Recommended) ---
# Get your free API key at: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_EMAIL="Royal Haven Inquiries <onboarding@resend.dev>"
EMAIL_RECEIVER=royalhavenrealtyproperty@gmail.com

# --- Brevo (Sendinblue) Transactional Email (Optional Fallback) ---
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=royalhavenrealtyproperty@gmail.com

# --- Supabase Cloud Database ---
# Get your project credentials from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
