# ==========================================
# Royal Haven Environment Configuration
# ==========================================

# --- Brevo (Sendinblue) Transactional Email ---
# Get your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=info@royalhaven.com.ng
BREVO_RECEIVER_EMAIL=royalhavenrealtyproperty@gmail.com

# --- Supabase Cloud Database ---
# Get your project credentials from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
